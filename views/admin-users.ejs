<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Admin - Manage Users</title>
  <style>
    :root {
      --google-blue: #4285f4;
      --google-red: #ea4335;
      --google-yellow: #fbbc05;
      --google-green: #34a853;
      --text-primary: #202124;
      --text-secondary: #5f6368;
      --background: #ffffff;
      --surface: #f8f9fa;
      --border: #dadce0;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Roboto', 'Segoe UI', Arial, sans-serif;
      background: var(--surface);
      margin: 0;
      color: var(--text-primary);
      line-height: 1.5;
    }
    .container {
      max-width: 900px;
      margin: 3rem auto;
      background: var(--background);
      border-radius: 8px;
      box-shadow: 0 2px 16px rgba(0,0,0,0.07);
      padding: 2.5rem 2rem;
      border: 1px solid var(--border);
    }
    h1 {
      color: var(--google-blue);
      margin-bottom: 2rem;
      text-align: center;
      font-size: 2.2rem;
      font-weight: 700;
      letter-spacing: 1px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1.5rem;
    }
    th, td {
      padding: 0.7rem;
      border-bottom: 1px solid var(--border);
      text-align: left;
    }
    th {
      background: var(--surface);
      color: var(--google-blue);
      font-weight: 600;
    }
    tr:hover {
      background: var(--background);
    }
    .delete-btn {
      background: var(--google-red);
      color: #fff;
      border: none;
      padding: 0.4rem 1rem;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.95rem;
      transition: background 0.2s;
    }
    .delete-btn:hover {
      background: #b71c1c;
    }
    @media (max-width: 700px) {
      .container {
        padding: 1.2rem 0.2rem;
        margin: 1rem auto;
      }
      h1 {
        font-size: 1.3rem;
      }
      table, th, td {
        font-size: 0.95rem;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Manage Users</h1>
    <table>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Actions</th>
      </tr>
      <% users.forEach(user => { %>
        <tr>
          <td><%= user.id %></td>
          <td><%= user.name %></td>
          <td><%= user.email %></td>
          <td>
            <form action="/admin/users/delete/<%= user.id %>" method="POST" style="display:inline;">
              <button type="submit" class="delete-btn">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>